---
title: RAG Assistant - Activity Diagram
---
flowchart LR
%% Two SEPARATE workflows (separate API requests). Uploading a document does not
%% start a question automatically; the user asks questions later.
%% Notation: black circle = start, ringed circle = end, diamond = decision.
%% The user must be logged in (JWT token) for both workflows.

subgraph UPLOAD["Workflow 1: Upload a document"]
    direction TB
    U0(("&nbsp;"))
    U1(["User uploads a PDF, TXT or MD file"])
    U2{"Logged in and<br/>valid file?"}
    U3(["Extract text from the file"])
    U4(["Split text into chunks"])
    U5(["Create embeddings for chunks"])
    U6(["Store vectors in Qdrant"])
    U7(["Save document details<br/>in PostgreSQL"])
    U8{"Processing<br/>successful?"}
    U9(["Return: document ingested"])
    UE(["Return error message"])
    UX((("&nbsp;")))

    U0 --> U1 --> U2
    U2 -- yes --> U3 --> U4 --> U5 --> U6 --> U7 --> U8
    U8 -- yes --> U9 --> UX
    U2 -- no --> UE
    U8 -- "no (file and vectors removed)" --> UE
    UE --> UX
end

subgraph QUERY["Workflow 2: Ask a question"]
    direction TB
    Q0(("&nbsp;"))
    Q1(["User asks a question"])
    Q2{"Logged in and<br/>valid question?"}
    Q3(["Create question embedding"])
    Q4(["Hybrid search:<br/>vector + BM25 keyword (RRF)"])
    Q5(["Rerank chunks with<br/>cross-encoder"])
    Q6{"Relevant chunks<br/>found?"}
    Q7(["Build context from<br/>top chunks"])
    Q8(["LLM generates answer"])
    Q9(["Attach citations and sources"])
    Q10(["Answer: no relevant<br/>information found"])
    Q11(["Save question and answer<br/>in conversation history"])
    Q12(["Return answer with citations"])
    QE(["Return error message"])
    QX((("&nbsp;")))

    Q0 --> Q1 --> Q2
    Q2 -- yes --> Q3 --> Q4 --> Q5 --> Q6
    Q6 -- yes --> Q7 --> Q8 --> Q9 --> Q11
    Q6 -- no --> Q10 --> Q11
    Q11 --> Q12 --> QX
    Q2 -- no --> QE --> QX
end

